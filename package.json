{
  "name": "lexiloop",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first English vocabulary flashcards with spaced repetition",
  "workspaces": [
    "backend",
    "frontend",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build && concurrently -n backend,frontend -c green,cyan \"npm run dev -w @lexiloop/backend\" \"npm run dev -w @lexiloop/frontend\"",
    "build": "npm run build -w @lexiloop/shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "npm run db:migrate -w @lexiloop/backend",
    "db:seed": "npm run db:seed -w @lexiloop/backend",
    "db:reset": "npm run db:reset -w @lexiloop/backend"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
