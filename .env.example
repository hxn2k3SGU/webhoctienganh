PORT=3001
DEV_ORIGINS=http://localhost:5173
DATABASE_PATH=./data/lexiloop.db
UPLOAD_DIR=./data/uploads
TZ=Asia/Ho_Chi_Minh
# Server only. Copy this file to backend/.env for npm workspace scripts.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Auth: access token 15 phut (cookie), refresh token 7 ngay (luu hash trong bang refresh_tokens).
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# Chuoi ngau nhien >= 32 ky tu de ky access token. Neu bo trong, server tao secret tam moi lan khoi dong.
AUTH_TOKEN_SECRET=
